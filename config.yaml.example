# Kronos Configuration Example
# Copy this file to config.yaml and update with your values

# Repository settings
repository:
  github_url: 'https://github.com/your-org/your-repo'  # GitHub repository URL
  default_branch: 'main'                                # Default branch to monitor
  local_path: '/repos/your-repo'                       # Local path where repo will be cloned
  github_token: '${GITHUB_TOKEN}'                     # GitHub personal access token (env var)
  git_timeout: 60                                     # Git operation timeout in seconds

# Loki logging configuration
loki:
  url: 'http://loki:3100/loki/api/v1/query_range'    # Loki query endpoint
  query_timeout: 30                                   # Query timeout in seconds
  log_limit: 1000                                    # Maximum number of logs to fetch
  retention: '24h'                                   # Log retention period

# LLM configuration (local)
llm:
  provider: local                                     # LLM provider (local/remote)
  model: 'qwen2.5-coder:7b'                          # Model name for local inference
  base_url: 'http://localhost:11434/v1'              # Ollama API endpoint
  max_tokens: 4000                                   # Maximum tokens in response
  temperature: 0.2                                   # Response temperature (0.0-1.0)
  timeout: 60                                        # Request timeout in seconds

# Claude compatibility (optional, kept for backward compatibility)
claude:
  api_key: 'ollama'                                  # API key (not used with local LLM)
  model: 'llama3.2:3b'                              # Alternative model
  base_url: 'http://localhost:11434'                # Alternative endpoint
  max_tokens: 2000                                  # Alternative max tokens
  temperature: 0.2                                  # Alternative temperature
  timeout: 60                                       # Alternative timeout

# Parcle integration (optional)
parcle:
  api_key: '${PARCLE_API_KEY}'                      # Parcle API key (env var)
  api_url: 'https://api.parcle.ai/v1'              # Parcle API endpoint
  workspace: 'your-workspace'                       # Parcle workspace name
  local_db_path: 'logs/parcle_local.db'            # Local database path

# Code style preferences
code_style:
  language: 'python'                                # Programming language
  formatter: 'black'                                # Code formatter to use
  naming_convention: 'snake_case'                   # Naming convention
  max_line_length: 120                             # Maximum line length

# Build configuration
build:
  command: 'python -m py_compile main.py'          # Build command
  timeout: 120                                      # Build timeout in seconds

# Test configuration
test:
  command: 'pytest -v'                             # Test command
  timeout: 180                                      # Test timeout in seconds

# Autonomy settings
autonomy:
  full_autonomous: true                            # Enable full autonomous mode
  max_generation_retries: 3                       # Maximum retries for generation
  approval_timeout: 3600                          # Timeout for manual approval (seconds)
  approval_poll_interval: 30                      # Polling interval for approvals (seconds)

# Error priority rules
rules:
  priority:
    high:
      error_patterns:                              # High priority error patterns
        - 'segmentation fault'
        - 'index out of range'
        - 'out of memory'
        - 'panic'
        - 'goroutine leak'
        - 'nil pointer'
        - 'deadlock'
      required_confidence: 0.75                   # Minimum confidence for auto-fix
      auto_fix: true                              # Auto-fix high priority errors
    medium:
      error_patterns:                              # Medium priority error patterns
        - 'type assertion'
        - 'race condition'
        - 'timeout'
        - 'resource leak'
      required_confidence: 0.70                   # Minimum confidence for auto-fix
      auto_fix: 'follow_autonomy'                 # Follow autonomy settings
    low:
      error_patterns:                              # Low priority error patterns
        - 'warning'
        - 'deprecation'
        - 'lint error'
      required_confidence: 0.60                   # Minimum confidence for auto-fix
      auto_fix: false                             # Don't auto-fix low priority

# Pattern cache settings
pattern_cache:
  similarity_threshold: 0.70                      # Similarity threshold for pattern matching

# Context retrieval settings
context_retrieval:
  max_workers: 4                                  # Maximum parallel workers
  grep_timeout: 30                                # Grep command timeout (seconds)
  max_function_lines: 50                         # Maximum lines per function
  max_callers: 5                                 # Maximum callers to retrieve
  max_keyword_matches: 10                        # Maximum keyword matches
  strip_comments: true                           # Strip comments from context
  max_context_tokens: 4000                       # Maximum context tokens
  token_allocation:                              # Token allocation for different context types
    error_logs: 0.30
    definitions: 0.35
    callers: 0.15
    keywords: 0.10
    git_changes: 0.10

# GitHub integration
github:
  reviewers:                                      # Pull request reviewers
    - 'maintainer_1'
    - 'maintainer_2'
  labels:                                         # PR labels
    - 'agent-generated'
    - 'incident-response'
  issue_labels:                                   # Issue labels
    - 'needs-review'
    - 'incident'

# Logging configuration
logging:
  level: 'INFO'                                   # Log level (DEBUG/INFO/WARNING/ERROR)
  file: 'logs/kronos.log'                        # Log file path
  json_format: true                              # Use JSON format for logs

# Notification settings
notifications:
  enabled: true                                   # Enable notifications
  dashboard_url: 'http://localhost:8000/dashboard'  # Dashboard URL
  min_priority: 'low'                            # Minimum priority to notify
  events:                                        # Events to notify about
    - incident_started
    - diagnosis_complete
    - fixing
    - pr_opened
    - issue_opened
    - failed
    - resolved
    - ignored
  slack:                                         # Slack integration (optional)
    enabled: false
    webhook_url: ''                              # Slack webhook URL
    mention: ''                                  # Users to mention (@username)
  email:                                         # Email integration
    enabled: true
    smtp_host: 'smtp.gmail.com'                  # SMTP server
    smtp_port: 587                               # SMTP port
    use_tls: true                                # Use TLS
    smtp_user: '${SMTP_USER}'                    # SMTP username (env var)
    smtp_password: '${SMTP_PASSWORD}'            # SMTP password (env var)
    from_address: 'your-email@gmail.com'         # From email address
    to_addresses:                                # Recipient email addresses
      - 'recipient@example.com'
